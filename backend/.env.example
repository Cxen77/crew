PORT=5001
MONGO_URI=mongodb://127.0.0.1:27017/crew-sync

# Optional LLM Configuration (leave blank to run with deterministic tool-grounded fallback)
# Provider options: gemini | openai | auto
LLM_PROVIDER=auto
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Or any OpenAI-compatible endpoint (OpenAI, Groq, OpenRouter, Ollama)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
